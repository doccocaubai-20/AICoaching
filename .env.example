# ==============================================================================
# CALISCOACHING MVP - CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (KHÔNG CHỨA BÍ MẬT)
# Sao chép tệp này thành .env.local để sử dụng trong phát triển cục bộ.
# ==============================================================================

# 1. Supabase Cục bộ / Dự án Supabase (BẮT BUỘC để kích hoạt Auth & Database)
# - Với Supabase Local: Chạy `supabase start` và điền URL/Anon Key từ terminal.
# - Với Supabase Cloud: Lấy từ Project Settings > API trong Supabase Dashboard.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder-do-not-commit-secrets

# 2. Supabase Service Role Key (CHỈ DÙNG Ở SERVER CHO CÁC TÁC VỤ ADMIN/MIGRATION KIỂM THỬ)
# TUYỆT ĐỐI KHÔNG DÙNG Ở CLIENT (KHÔNG THÊM TIỀN TỐ NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# 3. Cấu hình AI Provider (GIAI ĐOẠN SAU - AGENT E)
# Để trống nếu chưa cấu hình; hệ thống sẽ tự động kích hoạt fallback template mẫu có nhãn minh họa
AI_PROVIDER=
AI_API_KEY=
AI_MODEL_NAME=
